{
  "name": "contaduria-backend",
  "version": "1.0.0",
  "description": "Backend API para Sistema Contable y Recibos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql'); if(require('fs').existsSync('src/assets')) require('fs').cpSync('src/assets', 'dist/assets', {recursive: true});\"",
    "start": "node dist/server.js",
    "db:init": "ts-node-dev --transpile-only src/db/init.ts",
    "db:clear": "ts-node-dev --transpile-only src/db/clearDatabase.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
